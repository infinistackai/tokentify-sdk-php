# Copy to .env (never commit it).
TOKENTIFY_API_KEY=um_xxxxxxxxxxxx   # your Tokentify API key
TOKENTIFY_BUCKET=support-bot        # default bucket for usage
TOKENTIFY_APP_NAME=support-bot
# TOKENTIFY_VERIFY=false            # skip the startup API key check (local dev)

OPENAI_API_KEY=sk-...               # your provider key; sent only to OpenAI
