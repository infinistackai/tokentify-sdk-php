{
    "name": "tokentify/tokentify-sdk",
    "description": "Tokentify PHP SDK: meter AI API usage (tokens, speech, tools) out of band",
    "type": "library",
    "keywords": [
        "tokentify",
        "llm",
        "openai",
        "anthropic",
        "usage",
        "metering",
        "observability"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Tokentify"
        }
    ],
    "homepage": "https://github.com/infinistackai/tokentify-sdk-php",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.8",
        "phpunit/phpunit": "^10.5"
    },
    "suggest": {
        "ext-curl": "Recommended for reliable HTTP to the collector",
        "guzzlehttp/guzzle": "Automatic metering via Tokentify::guzzleMiddleware()"
    },
    "autoload": {
        "psr-4": {
            "Tokentify\\": "src/"
        },
        "files": [
            "legacy/aliases.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tokentify\\Test\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
