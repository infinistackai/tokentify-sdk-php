{
  "name": "tokentifyai/usagemeter",
  "description": "Out-of-band AI API usage metering SDK",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Tokentify"
    }
  ],
  "homepage": "https://github.com/infinistackai/tokentify-sdk-php",
  "require": {
    "php": ">=8.1",
    "ext-json": "*"
  },
  "suggest": {
    "ext-curl": "Recommended for reliable HTTP to the collector",
    "vlucas/phpdotenv": "Optional: load .env in development"
  },
  "autoload": {
    "psr-4": {
      "UsageMeter\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "UsageMeter\\Test\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
