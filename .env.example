# Global secrets — loaded by Tokentify::loadEnv() before Tokentify::setup().
# Do not pass TOKENTIFY_API_KEY in application code.

TOKENTIFY_API_KEY=
TOKENTIFY_BUCKET=

# Optional — local / self-hosted collector (default: http://api.tokentify.ai)
# TOKENTIFY_COLLECTOR_URL=http://localhost:4006

# Optional — set false for local dev when the collector is down
# TOKENTIFY_VERIFY=true

# Optional — legacy: load .env inside setup() instead of explicit loadEnv()
# TOKENTIFY_LOAD_DOTENV=false

# Optional — multi-provider bucket routing (alternative to setup(providerBuckets: [...]))
# TOKENTIFY_PROVIDER_BUCKETS=openai:openai,anthropic:anthropic,google:google

# TOKENTIFY_APP_NAME=my-app
# TOKENTIFY_ENVIRONMENT=production
# TOKENTIFY_DEBUG=false

# Optional — set false to start tracking only on an explicit Tokentify::setup()
# TOKENTIFY_AUTO_SETUP=true

# Metadata key name for context limit on ingest events (optional — defaults to max_tokens)
# TOKENTIFY_CONTEXT_LIMIT_KEY=max_tokens
