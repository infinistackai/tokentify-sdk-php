# Global secrets — loaded by init() when load_env_file is true (default with phpdotenv).
# Do not pass USAGEMETER_API_KEY in application code; keep it in .env only.
#
# Collector URL is fixed in the SDK for /health and /v1/ingest (not set in .env):
# http://tokentify.com:4006

USAGEMETER_API_KEY=
USAGEMETER_BUCKET=
