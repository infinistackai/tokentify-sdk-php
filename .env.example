# Global secrets — loaded when vlucas/phpdotenv is installed and init() runs with load_env_file=true.
# Do not pass USAGEMETER_API_KEY in application code; keep it in .env only.

USAGEMETER_API_KEY=
USAGEMETER_BUCKET=

# Optional (default in SDK if unset)
USAGEMETER_COLLECTOR_URL=http://205.209.126.182:8006
# USAGEMETER_ENVIRONMENT=production
# USAGEMETER_APP_NAME=my-service
